###
# example .env file - copy to .env and fill in secrets
###

# NSX manager hostnames
NSX_GM1=nsx-gm1.somedomain.local
NSX_GM2=nsx-gm2.somedomain.local
NSX_LM1=nsx-lm1.somedomain.local
NSX_LM2=nsx-lm2.somedomain.local
NSX_LM3=nsx-lm3.somedomain.local
NSX_LM4=nsx-lm4.somedomain.local

OBJECT_APPENDIX=_svb_m3

ROOT_DIR=/path/to/nsx_scripts
NSX_LOG_DIR=$ROOT_DIR/nsx_logs
NSX_VM_LOG_DIR=$ROOT_DIR/nsx_vm_files

# NSX credentials
NSX_USERNAME=admin
NSX_PASSWORD=changeme

# vCenter credentials
VCENTER_SERVER_1=vcenter1.somedomain.local
VCENTER_SERVER_2=vcenter2.somedomain.local
VCENTER_LOGIN=administrator@vsphere.local
VCENTER_PASSWORD=changeme

# VM hostname-tagging configuration (used by tools/vm_tags/)
# Comma-separated list of VM types eligible for tagging.
# Only VMs whose `type` field is in this list will be considered.
# All other types fall into skip_other_type (or skip_edge for type=EDGE).
VM_TAGS_SUPPORTED_TYPES=REGULAR

# Cap on existing tag count per VM before we refuse to add another.
# NSX allows up to 30 tags per VM; default below skips VMs already at or
# above the cap. A VM with this many tags falls into skip_too_many_tags
# and is flagged for operator review.
VM_TAGS_MAX_TAGS_PER_VM=30

# Regex that decides which VMs are eligible for hostname tagging and what
# the tag value will be. Applied to each VM's display_name via re.search().
# Contract:
#   - Must be a valid Python regex.
#   - Must contain at least one capture group; group(1) becomes the tag value.
#   - Typically anchored at the end (`$`) so it matches the suffix, but not
#     required.
#
# Length tuning: if the regex contains the literal string `{MIN,MAX}`, it is
# substituted with `{VM_TAGS_HOSTNAME_MIN_LEN,VM_TAGS_HOSTNAME_MAX_LEN}`
# (defaults 3/6). This lets operators tune the length range without needing
# to know regex quantifier syntax. Regexes without `{MIN,MAX}` are used
# verbatim.
#
# If unset OR invalid, the tool falls back to the default and logs a warning.
# The pattern in use (with substitutions applied) is logged on every run.
#
# Default (3-6 trailing digits, no more no less - backwards-compatible with
# the original hard-coded rule). The negative lookbehind rejects names with
# more trailing digits than MAX (e.g. "myhost-1234567" is rejected, not
# truncated).
VM_TAGS_HOSTNAME_REGEX=(?<!\d)(\d{MIN,MAX})$
VM_TAGS_HOSTNAME_MIN_LEN=3
VM_TAGS_HOSTNAME_MAX_LEN=6
#
# Other useful patterns (all support {MIN,MAX} substitution):
#   # 3-8 alphanumeric characters at the end after a hyphen:
#   VM_TAGS_HOSTNAME_REGEX=-([A-Za-z0-9]{MIN,MAX})$
#   VM_TAGS_HOSTNAME_MAX_LEN=8
#
#   # Last hyphen-separated token, any length (no length placeholder):
#   VM_TAGS_HOSTNAME_REGEX=-([^-]+)$
#
#   # Exactly 4 trailing digits (strict lab naming, no placeholder):
#   VM_TAGS_HOSTNAME_REGEX=(\d{4})$
#
#   # Trailing digits with optional letter suffix (e.g. "web-0042a"):
#   VM_TAGS_HOSTNAME_REGEX=(\d{MIN,MAX}[a-z]?)$

# Group label-tag sync (used by tools/nsx/sync_group_label_tags.py)
# Comma-separated TAG VALUES to mirror from a group's membership criteria into
# the group's own label tags. NSX stores a Tag condition as "scope|tag" (e.g.
# "0|network" is scope=0, tag=network); this list matches on the TAG value (the
# "Tag" field in the UI criterion), not the scope. For every VM Tag condition
# whose tag value is in this list, the full {scope, tag} is added to the group's
# `tags` (label). Existing label tags are preserved; the sync is additive only.
# Override per-run with --match-tags.
NSX_GROUP_LABEL_MATCH_TAGS=network,vm
