###
# example .env file - copy to .env and fill in secrets
#
# Every variable a current tool actually reads is listed below. Commented-out
# lines are optional (the code has a working default); uncommented lines are
# the ones a fresh checkout normally needs.
###

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
ROOT_DIR=/path/to/nsx_scripts
NSX_LOG_DIR=$ROOT_DIR/nsx_logs
NSX_VM_LOG_DIR=$ROOT_DIR/nsx_vm_files

# Output root for the Palo Alto tools (check_policy_match.py, recommend_dg.py,
# add_services_to_rules.py, panorama_auth.py, panorama_rest_auth.py). Each
# tool writes to $PANO_REPORTS_DIR/<tool>/<UTC_TS>/. Unset = <repo>/.pano_reports.
PANO_REPORTS_DIR=$ROOT_DIR/.pano_reports

# ---------------------------------------------------------------------------
# NSX managers and credentials
# ---------------------------------------------------------------------------
NSX_GM1=nsx-gm1.somedomain.local
NSX_GM2=nsx-gm2.somedomain.local
NSX_LM1=nsx-lm1.somedomain.local
NSX_LM2=nsx-lm2.somedomain.local
NSX_LM3=nsx-lm3.somedomain.local
NSX_LM4=nsx-lm4.somedomain.local

NSX_USERNAME=admin
NSX_PASSWORD=changeme

# Suffix appended to objects created by the clone/remap workflows.
OBJECT_APPENDIX=_svb_m3

# Client-side NSX API rate limiting (all tools). Requests per second cap.
# DEFAULT is 2 req/s when unset. Set 0 to disable pacing. 429/503 responses
# always retry with backoff (NSX_API_RETRY_MAX attempts, default 5),
# honoring Retry-After.
#NSX_API_MAX_RPS=2
#NSX_API_RETRY_MAX=5

# ---------------------------------------------------------------------------
# VM hostname-tagging configuration (used by tools/vm_tags/)
# ---------------------------------------------------------------------------
# Comma-separated list of VM types eligible for tagging.
# Only VMs whose `type` field is in this list will be considered.
# All other types fall into skip_other_type (or skip_edge for type=EDGE).
VM_TAGS_SUPPORTED_TYPES=REGULAR

# Cap on existing tag count per VM before we refuse to add another.
# NSX allows up to 30 tags per VM; default below skips VMs already at or
# above the cap. A VM with this many tags falls into skip_too_many_tags
# and is flagged for operator review.
VM_TAGS_MAX_TAGS_PER_VM=30

# Hostname-tag exclusion list. Path to a file of hostname VALUES that must
# NEVER be tagged (one value per line; blank lines and # comments ignored).
# A VM whose derived hostname value matches (case-insensitive) is classified
# skip_excluded and shown in its own report section, not tagged. Unset = no
# exclusions. Override per-run with --exclude-file. $VARS are expanded.
VM_TAGS_HOSTNAME_EXCLUDE_FILE=$ROOT_DIR/hostname_tag_exclude.txt

# NOTE: The hostname-tag matching regex and its length bounds live in code,
# not here. See DEFAULT_HOSTNAME_REGEX / DEFAULT_HOSTNAME_MIN_LEN /
# DEFAULT_HOSTNAME_MAX_LEN in tools/vm_tags/build_hostname_tag_plan.py.
# Current rule: last hyphen-delimited token, 3-8 alphanumeric chars.
# Setting VM_TAGS_HOSTNAME_REGEX / _MIN_LEN / _MAX_LEN in .env does NOTHING;
# no tool reads them.

# ---------------------------------------------------------------------------
# Group label-tag sync (used by tools/nsx/sync_group_label_tags.py)
# ---------------------------------------------------------------------------
# Comma-separated TAG VALUES to mirror from a group's membership criteria into
# the group's own label tags. NSX stores a Tag condition as "scope|tag" (e.g.
# "0|network" is scope=0, tag=network); this list matches on the TAG value (the
# "Tag" field in the UI criterion), not the scope. For every VM Tag condition
# whose tag value is in this list, the full {scope, tag} is added to the group's
# `tags` (label). Existing label tags are preserved; the sync is additive only.
# Override per-run with --match-tags.
NSX_GROUP_LABEL_MATCH_TAGS=network,vm, asl_id

# Which field of a Tag criterion the values above are compared against:
# 'scope' (default, corrected orientation) or 'tag' (legacy, value-based).
# Precedence: --match-on flag > this > 'scope'.
#NSX_GROUP_LABEL_MATCH_ON=scope

# ---------------------------------------------------------------------------
# Report target lists (each is: CLI flag > env var > repo-root default file)
# ---------------------------------------------------------------------------
# tools/reports/report_vms_in_rules.py  (--vm-list; default vm_rule_report_targets.txt)
#VM_RULE_REPORT_LIST=$ROOT_DIR/vm_rule_report_targets.txt
# tools/pan/report_flow_rules.py       (--flows;   default pan_flow_report_targets.csv)
#PAN_FLOW_REPORT_LIST=$ROOT_DIR/pan_flow_report_targets.csv
# tools/pan/report_ips_in_rules.py     (--ips;     default pan_ip_rule_targets.txt)
#PAN_IP_RULE_REPORT_LIST=$ROOT_DIR/pan_ip_rule_targets.txt
# tools/pan/report_ips_in_rules.py     (--exclude; default pan_ip_rule_exclude.txt)
#PAN_IP_RULE_EXCLUDE_LIST=$ROOT_DIR/pan_ip_rule_exclude.txt

# ---------------------------------------------------------------------------
# Panorama (used by tools/pan/ and app/palo/). Resolved by app/palo/pan_env.py.
# ---------------------------------------------------------------------------
# Host: first non-empty of panorama, ppanorama, PANORAMA_URL, PANORAMA_HOST
#       (bare hostname, host:port, or full https URL). Lowercase `panorama` is
#       checked first and is what the lab .env uses.
panorama=pano4.somedomain.local
#PANORAMA_URL=pano4.somedomain.local
# Management port when it is not 443 (a :port in the host setting wins).
#PANORAMA_PORT=443

# Auth precedence: an API key is preferred and, when set, the username and
# password are never consulted. Mint a key with
#   python tools/pan/panorama_auth.py --keygen --write-env
# With no key, the username/password pair is used and a key is generated on
# every run. Username: PANORAMA_USERNAME > ppanorama_username > vm_username.
# Password: PANORAMA_PASSWORD > ppanorama_password > vm_password.
#PANORAMA_API_KEY=
#PANORAMA_USERNAME=
#PANORAMA_PASSWORD=

# Shared fallback credentials (also used by the VM-tagging toolkit). These are
# the last entry in the username/password chain above, so the Panorama tools
# work with no PANORAMA_USERNAME/PANORAMA_PASSWORD set at all.
vm_username=admin
vm_password=changeme

# Restricted read-only Panorama account. Denied the XML API, granted REST
# reads. Selected explicitly by tools/pan/panorama_rest_auth.py --agent,
# tools/pan/probe_api_permissions.py, pan_group_remap_report.py and
# ssdd_toolkit_web.py, or via PanRestClient.from_env(user_env=..., password_env=...).
# When this pair is used, any stored PANORAMA_API_KEY is deliberately ignored.
agent_user=agent-ro
agent_password=changeme

# Set to false ONLY for lab Panoramas with self-signed certificates.
PANORAMA_TLS_VERIFY=true

# REST API version path segment used by app/palo/pan_rest_client.py
# (/restapi/<version>/...). Unset = v11.2. Override per-run with --rest-version.
#PANORAMA_REST_VERSION=v11.2

# ---------------------------------------------------------------------------
# Not read by any current tool. Kept because the lab .env carries them and
# manual/ad-hoc scripts may expect them. Nothing in app/ or tools/ reads these.
# ---------------------------------------------------------------------------
#VCENTER_SERVER_1=vcenter1.somedomain.local
#VCENTER_SERVER_2=vcenter2.somedomain.local
#VCENTER_LOGIN=administrator@vsphere.local
#VCENTER_PASSWORD=changeme
#VSPHERE11_SERVER=esxi11.somedomain.local
#VSPHERE12_SERVER=esxi12.somedomain.local
#VSPHERE_USERNAME=administrator@vsphere.local
#VSPHERE_PASSWORD=changeme
#edge_gateway_1=edge1.somedomain.local
#edge_gateway_2=edge2.somedomain.local
#edge_gateway_username=admin
#edge_gateway_password=changeme
