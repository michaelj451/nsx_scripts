# Palo Alto / Panorama tool report root (hidden, separate from NSX log dir).
# The .gitkeep is preserved so the dir exists on fresh clones.
.pano_reports/*
!.pano_reports/.gitkeep
pan_capture/
pan_reports/

# Palo Alto / Panorama configuration exports — drop them here, they're auto-ignored
# (the .gitkeep is kept so the directory exists for new clones)
tools/pan/configs/*
!tools/pan/configs/.gitkeep

# Operator-specific rule-name filter for offline analysis tools. The
# .example.txt is tracked as a template; rule_filter.txt is user-local.
tools/pan/rule_filter.txt
# Operator-specific subnet filter for report_flow_rules.py. Same arrangement:
# subnet_filter.example.txt is tracked, subnet_filter.txt is user-local.
tools/pan/subnet_filter.txt
# Real configs used as test inputs — kept alongside synthetic fixtures but ignored.
# Synthetic fixtures (panorama_running_config.xml, etc.) remain tracked.
tools/pan/tests/fixtures/script-test-*.xml
tools/pan/tests/fixtures/real-*.xml
# (legacy/explicit patterns kept commented for reference)
# modified-config.xml
# # running-config*.xml
# pano_export*
# changelog.json

